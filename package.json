{
  "name": "chowk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chowk/web",
    "build": "npm run typecheck && npm run build --workspace @chowk/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:browsers": "npm run build && playwright test",
    "sim:bench": "node scripts/run-node.mjs sim-bench",
    "sim:validate": "node scripts/run-node.mjs sim-validate",
    "train": "node scripts/run-node.mjs train",
    "train:export": "node scripts/run-node.mjs train-export",
    "train:tune": "node scripts/run-node.mjs train-tune",
    "bench": "node scripts/run-node.mjs bench",
    "bench:all": "node scripts/run-node.mjs bench all",
    "bench:calibrate": "node scripts/run-node.mjs calibrate",
    "bench:summarise": "node scripts/run-node.mjs bench summarise",
    "bench:readme": "node scripts/run-node.mjs bench readme",
    "bench:smoke": "node scripts/run-node.mjs bench smoke",
    "capture": "npm run build && node scripts/capture.mjs",
    "submission:prepare": "node scripts/prepare-submission.mjs",
    "assets:placeholders": "python assets/blender/placeholders.py",
    "assets:vehicles": "blender --background --python assets/blender/vehicles.py",
    "assets:district": "blender --background --python assets/blender/district.py",
    "assets:build": "node assets/scripts/build.mjs",
    "assets:check": "node assets/scripts/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "meshoptimizer": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
